{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mini-display",
  "version": "0.1.0",
  "identifier": "com.taxel.mini-display",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mini-display",
        "width": 2560,
        "height": 720,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "minimizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
